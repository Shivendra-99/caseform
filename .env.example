# Shiprocket Checkout (custom website) credentials, issued by Shiprocket after onboarding.
# Copy to .env.local for local dev; set the same names in Vercel > Project > Settings > Environment Variables.
# Server-only: never prefix these with VITE_, or they would ship to the browser.
SHIPROCKET_CHECKOUT_API_KEY=
SHIPROCKET_CHECKOUT_SECRET=
# staging (fastrr-api-dev.pickrr.com) while testing, production (checkout-api.shiprocket.com) when live.
SHIPROCKET_CHECKOUT_ENV=staging
# Public site URL used for product image links and the sync script, e.g. https://snapedge.in
SITE_URL=
# Supabase project (Project Settings > API Keys). The publishable key is safe in the browser;
# the products table is protected by row-level security (supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only (never VITE_): lets checkout reserve stock and the order webhook confirm it.
# Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=
